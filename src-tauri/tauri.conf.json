{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BarAI Desktop",
  "version": "1.0.7",
  "identifier": "it.baraidesktop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BarAI Desktop",
        "width": 1320,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Business",
    "copyright": "BarAI"
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:barai.sqlite"
      ]
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/spontonalessandro/barai-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
