{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for BarAI Desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "http:default",
    "http:allow-fetch",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://script.google.com/**"
        },
        {
          "url": "https://script.googleusercontent.com/**"
        },
        {
          "url": "https://*.googleusercontent.com/**"
        },
        {
          "url": "https://raw.githubusercontent.com/**"
        }
      ]
    }
  ]
}
